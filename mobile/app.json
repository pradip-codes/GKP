{
  "expo": {
    "name": "GharKaPaisa",
    "slug": "GharKaPaisa",
    "scheme": "gharkapaisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gharkapaisa.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GharKaPaisa requires camera access for KYC face verification, teleprompter video recording, and attendance liveness checks.",
        "NSMicrophoneUsageDescription": "GharKaPaisa requires microphone access for teleprompter video verification.",
        "NSFaceIDUsageDescription": "GharKaPaisa uses Face ID / biometric authentication for secure attendance verification."
      }
    },
    "android": {
      "package": "com.gharkapaisa.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "65a6253e-75c8-4245-88e4-0adf47339c99"
      }
    }
  }
}
